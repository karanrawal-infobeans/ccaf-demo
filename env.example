# MongoDB root credentials (used by Docker Compose)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# Database name
MONGO_DB=ccaf

# Prisma connection string
# Format: mongodb://<user>:<password>@localhost:27017/<db>?authSource=admin&directConnection=true
DATABASE_URL=mongodb://admin:changeme@localhost:27017/ccaf?authSource=admin&directConnection=true

# JWT signing secret — use a long random string in production
JWT_SECRET=changeme

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Mongo Express basic-auth credentials (web UI at http://localhost:8081)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=changeme
